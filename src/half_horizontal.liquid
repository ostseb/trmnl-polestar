{%- if cars == blank or cars.size == 0 -%}
<div class="layout layout--col layout--center gap--small">
  <span class="title">Väntar på data från bilarna</span>
  <span class="description text--center">Kör skriptet push.py med pluginens webhook-URL (se Om pluginen).</span>
</div>
<div class="title_bar"><span class="title">Polestar</span></div>
{%- else -%}
<div class="layout layout--row layout--stretch gap--large portrait:layout--col portrait:gap--small">
  {%- for car in cars limit: 2 -%}
  <div class="flex flex--col flex--center-y flex--left gap--xsmall grow">
    <div class="flex flex--row flex--between flex--center-y w--full">
      <span class="title">{{ car.name }}</span>
      <span class="label label--small {% if car.charging %}label--filled{% else %}label--outline{% endif %}">{{ car.status }}</span>
    </div>
    <div class="flex flex--row flex--center-y gap--small">
      <span class="value value--large value--tnums">{{ car.soc | default: "–" }}%</span>
      <span class="description">{{ car.range_km | default: "–" }} km{% if car.charging and car.ready_at %}<br>klar {{ car.ready_at }}{% endif %}{% if car.alerts.size > 0 %}<br><b>⚠ {{ car.alerts.first }}</b>{% endif %}</span>
    </div>
    <div class="progress-bar progress-bar--small w--full"><div class="track"><div class="fill" style="width: {{ car.soc | default: 0 }}%"></div></div></div>
  </div>
  {%- endfor -%}
</div>
<div class="title_bar"><span class="title">Polestar</span><span class="instance">{{ updated }}</span></div>
{%- endif -%}
